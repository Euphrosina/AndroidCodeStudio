# Downloaded signing key
# SECURITY FIX: keystores must never be committed. The previously committed
# signing/signing-key.jks and core/app/dev.keystore are removed from the index.
# They remain in git history and MUST be rotated + history-rewritten upstream.
signing-key.jks
signing/*.jks
signing/*.keystore
core/app/dev.keystore
core/app/*.jks
core/app/*.keystore

